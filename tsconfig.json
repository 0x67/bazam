{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // DOM types for the browser callbacks in packages/driver-web
    "lib": ["es2024", "dom"]
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "scripts",
    "evals",
    "examples/demo-app/src",
    "examples/demo-app/test",
    "examples/plugins",
    "vite.config.ts"
  ]
}
